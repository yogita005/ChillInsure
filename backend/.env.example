# ChillInsure Backend Configuration
# Copy this to .env and fill in with actual values

# Server Configuration
HOST=0.0.0.0
PORT=3001
DEBUG=True
LOG_LEVEL=info

# Database (Supabase)
DATABASE_URL=postgresql://user:password@host:port/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here
SUPABASE_SECRET=your_supabase_secret_here

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Weather API
WEATHER_API_KEY=your_weather_api_key
WEATHER_API_URL=https://api.openweathermap.org

# Payment Gateway (Razorpay / UPI)
PAYMENT_API_KEY=your_razorpay_api_key
PAYMENT_API_SECRET=your_razorpay_api_secret

# AQI Service
AQI_API_KEY=your_aqi_api_key
AQI_API_URL=https://api.aqi.cn

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# OTP Configuration
OTP_LENGTH=6
OTP_VALIDITY_MINUTES=10

# ML Model Paths
GIGSCORE_MODEL_PATH=./models/gigscore_model.pkl
FRAUD_DETECTION_MODEL_PATH=./models/fraud_detection_model.pkl

# Monitoring & Alerts
ENABLE_WEBHOOKS=True
WEBHOOK_SECRET=webhook_secret_key

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8081","https://yourdomain.com"]

# Logging
LOG_FILE=logs/chillinsure.log
ENABLE_FILE_LOGGING=True
